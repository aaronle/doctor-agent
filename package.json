{
  "name": "doctor-agent",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": ".venv/bin/uvicorn app.main:app --app-dir apps/api --host 127.0.0.1 --port 8000 --reload",
    "dev:web": "npm run dev --workspace @doctor-agent/web",
    "build": "npm run build --workspace @doctor-agent/web",
    "test": "npm run test --workspace @doctor-agent/web",
    "test:web": "npm run test --workspace @doctor-agent/web",
    "test:api": ".venv/bin/python -m pytest apps/api/tests",
    "test:all": "npm run typecheck && npm run test:web && npm run test:api",
    "contracts:export": ".venv/bin/python scripts/export_contracts.py",
    "typecheck": "npm run typecheck --workspace @doctor-agent/web",
    "fidelity": "node scripts/compare-v43-fidelity.mjs",
    "extract": "node scripts/extract-v43-assets.mjs && node scripts/extract-v43-dom.mjs && node scripts/split-v43-css.mjs",
    "verify": "node scripts/verify.mjs",
    "coverage": "node scripts/check-v43-coverage.mjs",
    "verify:legacy": "npm run test:all && npm run build && npm run contracts:export && npm run fidelity && npm run coverage",
    "deploy": "node scripts/deploy.mjs",
    "logo": "node design/logo/build-assets.mjs",
    "smoke": "node scripts/smoke-prod.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:check": "node scripts/demo-check.mjs",
    "demo:walk": "node scripts/demo-walk.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
