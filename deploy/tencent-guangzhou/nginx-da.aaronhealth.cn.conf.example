server {
    listen 80;
    listen [::]:80;
    server_name da.aaronhealth.cn;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    # 两个 SSE 端点：病历分段流式生成与语音追问建议。
    # 必须关闭缓冲，否则 Nginx 会攒到响应结束才一次性下发，
    # 逐字生成的效果全部丢失，且首屏聚合超过 60s 时会被读超时切断。
    location ~ ^/api/emr/(copilot/chat|voice/turn)$ {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding on;
        proxy_read_timeout 300s;
    }

    # 智慧诊疗聚合会并发跑四个岗位，冷启动约 20 秒，
    # 默认 60s 够用但留出余量，避免网关抖动重试后被切断。
    location /api/emr/report-summary/ {
        proxy_pass http://127.0.0.1:3400;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
