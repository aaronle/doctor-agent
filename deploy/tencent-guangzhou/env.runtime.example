# 服务器上放在 /opt/doctor-agent/config/.env.runtime，权限必须为 600。
# 含密钥，不进 Git、不进日志、不下发前端、不出现在健康接口。

DOCTOR_AGENT_RELEASE=0.3.0-mvp
DOCTOR_AGENT_ENVIRONMENT=mvp
DOCTOR_AGENT_DATABASE_URL=sqlite:////app/data/doctor-agent.db
DOCTOR_AGENT_RUNTIME_MODE=live
DOCTOR_AGENT_WRITE_BACK_MODE=local
DOCTOR_AGENT_CORS_ORIGINS=https://da.aaronhealth.cn

# 模型通道。与 ts-it-service 共用同一组变量名和同一个第三方网关。
# 密钥从 projects/ts-it-service/.env.runtime 同步，不要在文档里复制粘贴其值。
AI_API_KEY=
AI_BASE_URL=https://www.meatdc.com/v1
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_SMART_MODEL=claude-sonnet-5
AI_TIMEOUT_MS=45000

# 置为 rules 时全部岗位走确定性本地规则，不调模型。
# 用于网关不可用时的应急兜底演示，正式发布留空。
AI_TEST_MODE=
