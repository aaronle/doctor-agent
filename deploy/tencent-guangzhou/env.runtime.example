# 服务器上放在 /opt/doctor-agent/config/.env.runtime，权限必须为 600。
# 含密钥，不进 Git、不进日志、不下发前端、不出现在健康接口。

DOCTOR_AGENT_RELEASE=0.3.0-mvp
DOCTOR_AGENT_ENVIRONMENT=mvp
DOCTOR_AGENT_DATABASE_URL=sqlite:////app/data/doctor-agent.db
DOCTOR_AGENT_RUNTIME_MODE=live
DOCTOR_AGENT_WRITE_BACK_MODE=local
DOCTOR_AGENT_CORS_ORIGINS=https://da.aaronhealth.cn

# 模型通道。与 ts-it-service 共用同一组变量名和同一个第三方网关。
# 密钥从 projects/ts-it-service/.env.runtime 同步，不要在文档里复制粘贴其值。
AI_API_KEY=
AI_BASE_URL=https://www.meatdc.com/v1
# ⚠ **这两个不再决定六个岗位用什么模型。**
#
# 2026-09-02 起岗位模型只看「档位」（见下），fast/smart 只管**不走档位**的
# 那些调用（Copilot 对话等）。让 AI_FAST_MODEL 参与档位解析的话，
# 档位拆分会被它整体盖掉 —— 代码里三档分开、线上三档一样，而且不报错。
#
# 这个项目已经因为「env 盖住代码缺省」栽过一次：上次换模型只改了代码缺省，
# 这里没改，于是编排层换成了 Sonnet、产品路径六个岗位还在跑 Haiku，
# 而 /api/health 一直如实报着，只是没人去看。
AI_FAST_MODEL=claude-sonnet-5
AI_SMART_MODEL=claude-sonnet-5

# 岗位模型档位。留空则用代码缺省（agent_config.DEFAULT_TIER_MODELS）：
#   clinical_fast      = claude-haiku-4-5-20251001   ← record
#   clinical_reasoning = claude-sonnet-5             ← summary / diagnosis / comorbidity / voice
#   clinical_safety    = claude-sonnet-5             ← risk
#
# 分配依据是实测，不是猜：record 在两个模型上回归集都是 10/10，
# 而耗时 45.8s → 5.0s。其余岗位**没有足够用例**，一律留在能力更强的一侧。
# report-summary 里那四个是并发的，所以它的耗时等于最慢的那个（risk，52.2s）——
# 动另外三个一秒都省不下来。
#
# 以 /api/health 的 modelTiers 为准，不是以这个文件为准。
AI_MODEL_CLINICAL_FAST=
AI_MODEL_CLINICAL_REASONING=
AI_MODEL_CLINICAL_SAFETY=
# 应急整体覆盖：三档一起换，用于「先全切回某个模型再说」
AI_MODEL_ALL_TIERS=
# Sonnet 比 Haiku 慢，45s 会让单个岗位擦边超时后降级为本地规则。
AI_TIMEOUT_MS=90000

# 交付平台的写入口令。开发机上的 scripts/verify.mjs 与 scripts/deploy.mjs 带它上报。
# **不配就关闭写入通道**（读不受影响）—— 这个服务在公网上，
# 一个默认放行的写接口意味着任何人都能往发布历史里塞记录。
# 生成：openssl rand -hex 24
DELIVERY_INGEST_TOKEN=

# 置为 rules 时全部岗位走确定性本地规则，不调模型。
# 用于网关不可用时的应急兜底演示，正式发布留空。
AI_TEST_MODE=
